---
// Chọn phân loại giống Shopee: bấm chọn từng nhóm, giá đổi theo biến thể đã chọn.
import { formatPrice, type Product } from "../lib/products";
interface Props { product: Product }
const { product } = Astro.props;
const data = product.variants.map((v) => ({ o: v.options, p: v.price }));
---
<div class="picker" data-variants={JSON.stringify(data)} data-range={formatPrice(product)}>
  <p class="price" aria-live="polite">{formatPrice(product)}</p>
  {product.optionGroups.map((g, gi) => (
    <div class="row">
      <span class="label">{g.name}</span>
      <div class="opts" role="group" aria-label={g.name}>
        {g.values.map((v) => (
          <button type="button" class="opt" data-group={gi} data-value={v} data-image={product.optionImages[v]} aria-pressed="false">
            {product.optionImages[v] && <img src={product.optionImages[v]} alt="" loading="lazy" />}{v}
          </button>
        ))}
      </div>
    </div>
  ))}
  <p class="hint">Chọn phân loại để xem giá chính xác.</p>
</div>

<script>
  const fmt = (n: number) => n.toLocaleString("vi-VN") + "đ";

  document.querySelectorAll<HTMLElement>(".picker").forEach((root) => {
    const variants: { o: string[]; p: number | null }[] = JSON.parse(root.dataset.variants ?? "[]");
    const groups = Math.max(0, ...variants.map((v) => v.o.length));
    const picked: (string | null)[] = Array(groups).fill(null);
    const buttons = [...root.querySelectorAll<HTMLButtonElement>(".opt")];
    const priceEl = root.querySelector<HTMLElement>(".price")!;
    const hint = root.querySelector<HTMLElement>(".hint")!;

    // Biến thể còn khớp nếu chọn thêm giá trị `value` ở nhóm `gi`.
    const matching = (gi: number, value: string | null) =>
      variants.filter((v) => picked.every((pv, i) => (i === gi ? value === null || v.o[i] === value : pv === null || v.o[i] === pv)));

    function render() {
      for (const b of buttons) {
        const gi = Number(b.dataset.group);
        const on = picked[gi] === b.dataset.value;
        b.setAttribute("aria-pressed", String(on));
        b.disabled = !on && matching(gi, b.dataset.value!).length === 0;
      }
      const prices = matching(-1, null).map((v) => v.p).filter((p): p is number => p != null);
      const done = picked.every((p) => p !== null);
      if (!prices.length) priceEl.textContent = root.dataset.range ?? "";
      else {
        const lo = Math.min(...prices), hi = Math.max(...prices);
        priceEl.textContent = lo === hi ? fmt(lo) : `${fmt(lo)} – ${fmt(hi)}`;
      }
      hint.hidden = done;
    }

    // Báo khung ảnh (ProductGallery) đổi sang ảnh của phân loại vừa chọn.
    const showImage = (src: string | null) =>
      document.dispatchEvent(new CustomEvent("option-image", { detail: src }));
    let lastImage: string | null = null;

    for (const b of buttons) {
      b.addEventListener("click", () => {
        const gi = Number(b.dataset.group);
        picked[gi] = picked[gi] === b.dataset.value ? null : b.dataset.value!;
        if (b.dataset.image) {
          // Bỏ chọn thì quay về ảnh của phân loại khác còn đang chọn (nếu có).
          const still = buttons.find((o) => o.dataset.image && picked[Number(o.dataset.group)] === o.dataset.value);
          lastImage = picked[gi] ? b.dataset.image : still?.dataset.image ?? null;
          showImage(lastImage);
        }
        render();
      });
      if (b.dataset.image) {
        b.addEventListener("mouseenter", () => !b.disabled && showImage(b.dataset.image!));
        b.addEventListener("mouseleave", () => showImage(lastImage));
      }
    }
    render();
  });
</script>

<style>
  .price { font-size: 1.6rem; font-weight: 800; color: var(--accent-ink); background: var(--soft); padding: 12px 16px; border-radius: 10px; margin: 0 0 20px; }
  .row { display: grid; grid-template-columns: 110px 1fr; gap: 12px; margin-bottom: 16px; align-items: start; }
  .label { color: var(--muted); font-size: .95rem; padding-top: 8px; }
  .opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .opt { display: inline-flex; align-items: center; gap: 8px; font: inherit; font-size: .9rem; background: var(--surface); color: var(--ink); border: 1px solid var(--line); border-radius: 6px; padding: 7px 12px; cursor: pointer; text-align: left; }
  .opt img { width: 28px; height: 28px; object-fit: cover; border-radius: 3px; margin: -3px 0 -3px -6px; }
  .opt:hover:not(:disabled) { border-color: var(--accent); color: var(--accent-ink); }
  .opt[aria-pressed="true"] { border-color: var(--accent); color: var(--accent-ink); background: var(--soft); font-weight: 600; }
  .opt:disabled { opacity: .4; cursor: not-allowed; text-decoration: line-through; }
  .hint { margin: 0 0 8px; font-size: .85rem; color: var(--muted); }
  @media (max-width: 480px) { .row { grid-template-columns: 1fr; gap: 6px; } .label { padding-top: 0; } }
</style>
