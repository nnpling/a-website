---
// Khung ảnh trang sản phẩm giống Shopee: ảnh lớn + dải ảnh nhỏ bên dưới.
// Khi khách chọn phân loại có ảnh riêng, VariantPicker báo sang đây để đổi ảnh lớn.
import Placeholder from "./Placeholder.astro";
import { categoryName, type Product } from "../lib/products";
interface Props { product: Product }
const { product } = Astro.props;
const { images } = product;
---
{images.length === 0
  ? <div class="main"><Placeholder label={categoryName(product.categorySlug)} /></div>
  : (
    <div class="gallery" data-gallery>
      <div class="main">
        <img src={images[0]} alt={product.shortName} data-main fetchpriority="high" />
        {images.length > 1 && <>
          <button type="button" class="nav prev" data-step="-1" aria-label="Ảnh trước">‹</button>
          <button type="button" class="nav next" data-step="1" aria-label="Ảnh sau">›</button>
        </>}
      </div>
      {images.length > 1 && (
        <div class="thumbs">
          {images.map((src, i) => (
            <button type="button" class="thumb" data-index={i} aria-current={i === 0 ? "true" : "false"} aria-label={`Ảnh ${i + 1}`}>
              <img src={src} alt="" loading="lazy" />
            </button>
          ))}
        </div>
      )}
    </div>
  )}

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((root) => {
    const main = root.querySelector<HTMLImageElement>("[data-main]")!;
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>(".thumb")];
    let index = 0;

    const show = (i: number) => {
      index = (i + thumbs.length) % thumbs.length;
      main.src = thumbs[index].querySelector("img")!.src;
      thumbs.forEach((t, j) => t.setAttribute("aria-current", String(j === index)));
      thumbs[index].scrollIntoView({ block: "nearest", inline: "nearest" });
    };

    thumbs.forEach((t, i) => t.addEventListener("click", () => show(i)));
    root.querySelectorAll<HTMLButtonElement>(".nav").forEach((b) =>
      b.addEventListener("click", () => show(index + Number(b.dataset.step))));

    // Ảnh phân loại: src = ảnh để hiện, null = quay lại ảnh đang chọn trong dải.
    document.addEventListener("option-image", (e) => {
      const src = (e as CustomEvent<string | null>).detail;
      if (src) {
        main.src = src;
        thumbs.forEach((t) => t.setAttribute("aria-current", "false"));
      } else if (thumbs.length) show(index);
      else main.src = main.dataset.first ?? main.src;
    });
    main.dataset.first = main.src;
  });
</script>

<style>
  .main { position: relative; aspect-ratio: 1; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); background: var(--surface); }
  .main img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .nav { position: absolute; top: 50%; transform: translateY(-50%); width: 36px; height: 48px; border: 0; border-radius: 6px; background: rgb(0 0 0 / .28); color: #fff; font-size: 1.8rem; line-height: 1; cursor: pointer; opacity: .85; }
  .nav:hover { background: rgb(0 0 0 / .45); }
  .prev { left: 8px; } .next { right: 8px; }
  .thumbs { display: flex; gap: 8px; margin-top: 10px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: thin; }
  .thumb { flex: 0 0 72px; aspect-ratio: 1; padding: 0; border: 2px solid transparent; border-radius: 8px; overflow: hidden; background: var(--surface); cursor: pointer; }
  .thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .thumb[aria-current="true"] { border-color: var(--accent); }
  @media (max-width: 480px) { .thumb { flex-basis: 60px; } }
</style>
