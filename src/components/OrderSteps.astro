---
const steps = [
  { title: "Chọn mẫu", text: "Xem sản phẩm và chọn kiểu, kích thước bạn thích." },
  { title: "Gửi thông tin", text: "Đặt trên Shopee rồi nhắn tiệm hình ảnh, tên và bài hát muốn in." },
  { title: "Duyệt mẫu", text: "Tiệm gửi bản thiết kế để bạn xem trước khi in." },
  { title: "Nhận hàng", text: "Tiệm in, đóng gói và gửi tới bạn." },
];
---
<ol class="steps">
  {steps.map((s, i) => (
    <li><span class="n">{i + 1}</span><div><strong>{s.title}</strong><p>{s.text}</p></div></li>
  ))}
</ol>
<style>
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
  li { display: flex; gap: 12px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; }
  .n { flex: none; width: 32px; height: 32px; border-radius: 50%; background: var(--accent); color: #fff; font-weight: 700; display: grid; place-items: center; }
  p { margin: 4px 0 0; color: var(--muted); font-size: .95rem; }
</style>
