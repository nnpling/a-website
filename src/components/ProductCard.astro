---
import ProductImage from "./ProductImage.astro";
import { formatPrice, type Product } from "../lib/products";
interface Props { product: Product; seed?: number }
const { product, seed } = Astro.props;
---
<a class="card" href={`/san-pham/${product.slug}/`}>
  <div class="thumb">
    <ProductImage product={product} seed={seed} />
    {product.type === "custom" && <span class="badge">Làm theo yêu cầu</span>}
  </div>
  <div class="body">
    <h3>{product.shortName}</h3>
    <p class="price">{formatPrice(product)}</p>
  </div>
</a>
<style>
  .card { display: flex; flex-direction: column; background: var(--surface); border-radius: var(--radius); overflow: hidden; color: inherit; text-decoration: none; border: 1px solid var(--line); transition: transform .15s, box-shadow .15s; }
  .card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgb(0 0 0 / .08); }
  .thumb { position: relative; aspect-ratio: 1; }
  .badge { position: absolute; top: 10px; left: 10px; background: var(--ink); color: var(--bg); font-size: .75rem; font-weight: 600; padding: 4px 8px; border-radius: 999px; }
  .body { padding: 12px 14px 16px; }
  h3 { font-size: .95rem; font-weight: 600; margin: 0 0 6px; line-height: 1.35; }
  .price { margin: 0; color: var(--accent-ink); font-weight: 700; }
</style>
