---
// Ảnh tạm cho tới khi có ảnh sản phẩm thật.
interface Props { label: string; seed?: number }
const { label, seed = 0 } = Astro.props;
const hues = [12, 340, 200, 160, 40, 270];
const hue = hues[seed % hues.length];
---
<svg viewBox="0 0 400 400" role="img" aria-label={`Ảnh minh hoạ: ${label}`} class="ph">
  <rect width="400" height="400" fill={`hsl(${hue} 70% 92%)`} />
  <circle cx="200" cy="180" r="110" fill={`hsl(${hue} 30% 18%)`} />
  <circle cx="200" cy="180" r="80" fill="none" stroke={`hsl(${hue} 20% 30%)`} stroke-width="2" />
  <circle cx="200" cy="180" r="56" fill="none" stroke={`hsl(${hue} 20% 30%)`} stroke-width="2" />
  <circle cx="200" cy="180" r="34" fill={`hsl(${hue} 75% 62%)`} />
  <circle cx="200" cy="180" r="5" fill={`hsl(${hue} 70% 92%)`} />
  <text x="200" y="345" text-anchor="middle" font-family="system-ui, sans-serif" font-size="26" font-weight="600" fill={`hsl(${hue} 30% 22%)`}>{label}</text>
</svg>
<style>
  .ph { display: block; width: 100%; height: 100%; }
</style>
